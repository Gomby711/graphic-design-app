# Copy this file to .env (which is git-ignored) and fill in real values.
# Generate the hash with:  npm run hash-password -- "Boston5940!"
SITE_PASSWORD_HASH=
# Any long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=8932
# Set to "true" once the site is served over HTTPS (required in production
# so the session cookie is only ever sent encrypted).
COOKIE_SECURE=false
