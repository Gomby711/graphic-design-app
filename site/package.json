{
  "name": "graphic-design-tips-site",
  "private": true,
  "version": "1.0.0",
  "description": "Password-gated web portal for Graphic Design Tips — server-side auth + reskinned lesson viewer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:worker-assets": "node scripts/build-worker-assets.mjs",
    "hash-password": "node server/hash-password.js",
    "hash-password:worker": "node scripts/hash-password-worker.mjs",
    "start": "node server/index.js",
    "worker:dev": "npm run build && npm run build:worker-assets && wrangler dev --config ../wrangler.jsonc",
    "worker:deploy": "npm run build && npm run build:worker-assets && wrangler deploy --config ../wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "lucide-react": "^0.451.0",
    "three": "^0.169.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^4.21.0",
    "cookie-parser": "^1.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.24.0"
  }
}
